[ "$CI" = "true" ] && exit 0

# Mặc định: không chạy E2E khi push/Sync (nhanh). CI trên GitHub vẫn chạy Playwright.
if [ "$RUN_E2E_ON_PUSH" != "1" ]; then
  echo "▶ Pre-push E2E bỏ qua (mặc định). Để chạy local: RUN_E2E_ON_PUSH=1 git push"
  exit 0
fi

if [ ! -f public/build/manifest.json ]; then
  echo "▶ Building frontend assets (required for E2E)..."
  npm run build || exit 1
fi
node tests/e2e/helpers/stopStaleE2ePorts.js 2>/dev/null || true
if [ -z "$PLAYWRIGHT_E2E_PORT" ]; then
  PLAYWRIGHT_E2E_PORT="$(node tests/e2e/helpers/pickE2ePort.js)" || exit 1
  export PLAYWRIGHT_E2E_PORT
fi
export PLAYWRIGHT_BASE_URL="http://127.0.0.1:${PLAYWRIGHT_E2E_PORT}"
echo "▶ Running Playwright E2E tests (chromium) on ${PLAYWRIGHT_BASE_URL}..."
node node_modules/@playwright/test/cli.js test --project=chromium --reporter=dot
if [ $? -ne 0 ]; then
  echo "✗ E2E tests failed. Push aborted."
  exit 1
fi
