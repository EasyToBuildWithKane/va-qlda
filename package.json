{
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=20.19.0"
    },
    "scripts": {
        "dev": "node node_modules/vite/bin/vite.js",
        "build": "node node_modules/vite/bin/vite.js build",
        "lint": "eslint resources/js --max-warnings=0",
        "lint:fix": "eslint resources/js --fix --max-warnings=0",
        "test:e2e": "node node_modules/@playwright/test/cli.js test --project=chromium",
        "test:e2e:smoke": "node node_modules/@playwright/test/cli.js test --project=smoke",
        "test:e2e:visual": "node node_modules/@playwright/test/cli.js test --project=visual",
        "test:e2e:visual:update": "node node_modules/@playwright/test/cli.js test --project=visual --update-snapshots",
        "test:e2e:ui": "node node_modules/@playwright/test/cli.js test --ui",
        "test:e2e:install": "node node_modules/playwright/cli.js install --with-deps chromium",
        "prepare": "node node_modules/husky/bin.js",
        "lint-staged": "node node_modules/lint-staged/bin/lint-staged.js",
        "commitlint": "node node_modules/@commitlint/cli/lib/cli.js",
        "commit:msg": "node scripts/generate-commit-msg.mjs",
        "commit": "node scripts/auto-commit.mjs",
        "push:e2e": "node scripts/push-with-e2e.mjs",
        "realtime": "node realtime/server.mjs",
        "realtime:dev": "node --watch realtime/server.mjs"
    },
    "lint-staged": {
        "resources/js/**/*.{js,ts,jsx,tsx,vue}": [
            "eslint --fix --max-warnings=0"
        ]
    },
    "devDependencies": {
        "@commitlint/cli": "^21.0.2",
        "@commitlint/config-conventional": "^21.0.2",
        "@eslint/js": "^9.39.4",
        "@playwright/test": "^1.49.1",
        "@vitejs/plugin-vue": "^6.0.7",
        "autoprefixer": "^10.5.0",
        "axios": "^1.6.4",
        "eslint": "^9.39.4",
        "eslint-plugin-vue": "^10.9.1",
        "globals": "^17.6.0",
        "husky": "^9.1.7",
        "ioredis": "^5.6.1",
        "laravel-vite-plugin": "^1.0.0",
        "lint-staged": "^16.1.6",
        "postcss": "^8.5.15",
        "socket.io": "^4.8.1",
        "tailwindcss": "^3.4.19",
        "vite": "^5.0.0"
    },
    "dependencies": {
        "@fullcalendar/core": "^6.1.20",
        "@fullcalendar/daygrid": "^6.1.20",
        "@fullcalendar/interaction": "^6.1.20",
        "@fullcalendar/list": "^6.1.20",
        "@fullcalendar/timegrid": "^6.1.20",
        "@fullcalendar/vue3": "^6.1.20",
        "@inertiajs/vue3": "^2.3.24",
        "@tiptap/extension-image": "^3.24.0",
        "@tiptap/extension-link": "^3.24.0",
        "@tiptap/extension-placeholder": "^3.24.0",
        "@tiptap/extension-underline": "^3.24.0",
        "@tiptap/pm": "^3.24.0",
        "@tiptap/starter-kit": "^3.24.0",
        "@tiptap/vue-3": "^3.24.0",
        "@vuepic/vue-datepicker": "^14.0.0",
        "chart.js": "^4.5.1",
        "docx-preview": "^0.3.7",
        "frappe-gantt": "^1.2.2",
        "lucide-vue-next": "^1.0.0",
        "markdown-it": "^14.2.0",
        "ogl": "^1.0.11",
        "pinia": "^3.0.4",
        "socket.io-client": "^4.8.1",
        "vue": "^3.5.35",
        "vue-chartjs": "^5.3.3",
        "xlsx": "^0.18.5",
        "xlsx-js-style": "^1.2.0",
        "ziggy-js": "^2.6.2"
    }
}
