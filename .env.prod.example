##############################################################################
# VA Workspace — Production environment (mẫu, không secret)
# Domain: https://projects.vaschools.edu.vn
#
# Copy:
#   cp .env.prod.example .env.production   # local draft (gitignore)
#   # hoặc trên server: cp .env.prod.example .env rồi điền giá trị thật
#
# Sau khi điền .env trên server:
#   php artisan config:clear && php artisan config:cache
#   php artisan storage:link
#   php artisan settings:import-from-env   # tuỳ chọn — seed /settings từ .env
#
# Vận hành (Telegram, domain Google, email công việc, nhắc AI…):
#   Quản trị → Cấu hình hệ thống → /settings (lưu DB, không cần redeploy).
##############################################################################


# =============================================================================
# [1] APPLICATION CORE
# =============================================================================
APP_NAME="VA Workspace"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://projects.vaschools.edu.vn

# false = entry login/dashboard; landing CN chỉ /demo_1; /congnghe redirect
CONGNGHE_LANDING_PUBLIC=false

# POST /login chỉ E2E/PHPUnit — production phải false
AUTH_PASSWORD_LOGIN=false

VITE_APP_NAME="${APP_NAME}"


# =============================================================================
# [2] LOGGING
# =============================================================================
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning


# =============================================================================
# [3] DATABASE — MySQL (app)
# =============================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=va_workspace_prod
DB_USERNAME=
DB_PASSWORD=


# =============================================================================
# [4] HRM — nguồn nhân sự (Public API v1 M2M)
# Không dùng CMS_DB_* / cms:sync-* (đã gỡ).
# Mint token tại HRM /admin/api-clients (client workspace).
# JWT SSO (HRM_SSO_*) ≠ Bearer HRM_API_TOKEN.
# =============================================================================
HRM_API_BASE_URL=https://hrm.vaschools.edu.vn/api/v1
HRM_API_TOKEN=
# HRM_API_TIMEOUT=10


# =============================================================================
# [5] CACHE / SESSION / QUEUE
# =============================================================================
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=.vaschools.edu.vn
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=sync
BROADCAST_DRIVER=log
FILESYSTEM_DISK=public


# =============================================================================
# [6] SANCTUM (Inertia SPA)
# =============================================================================
SANCTUM_STATEFUL_DOMAINS=projects.vaschools.edu.vn


# =============================================================================
# [7] GOOGLE OAUTH — chỉ client secret (domain/email → /settings → Đăng nhập)
# Callback: ${APP_URL}/auth/google/callback
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Seed /settings lần đầu (sau đó quản lý tại /settings → Đăng nhập).
# Subdomain campus (hcm.…) được chấp nhận nếu có vaschools.edu.vn trong list.
# GOOGLE_ALLOWED_DOMAINS=vaschools.edu.vn,hcm.vaschools.edu.vn


# =============================================================================
# [8] SSO HRM → Workspace (IdP nội bộ)
# Bật: HRM_SSO_ENABLED=true; whitelist callback ${APP_URL}/auth/hrm/callback
# trên HRM (/admin/api-clients, client workspace, sso_enabled=true).
# Khi bật, login đi qua HRM — không gọi Google OAuth riêng trên Workspace.
# =============================================================================
HRM_SSO_ENABLED=false
HRM_SSO_BASE_URL=https://hrm.vaschools.edu.vn
HRM_SSO_CLIENT_ID=workspace
HRM_SSO_AUDIENCE=workspace
# HRM_SSO_ISSUER=https://hrm.vaschools.edu.vn
# HRM_SSO_JWKS_URL="${HRM_SSO_BASE_URL}/.well-known/jwks.json"


# =============================================================================
# [9] MAIL — SMTP (bật/tắt gửi email công việc → /settings → Email)
# =============================================================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"


# =============================================================================
# [10] REDIS — khi chuyển CACHE / SESSION / QUEUE sang redis
# =============================================================================
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379


# =============================================================================
# [11] REALTIME — Socket.IO (npm run realtime + proxy /socket.io/)
# =============================================================================
REALTIME_ENABLED=true
REALTIME_SECRET="${APP_KEY}"
REALTIME_REDIS_CHANNEL=va-workspace:realtime
REALTIME_CLIENT_URL=https://projects.vaschools.edu.vn
REALTIME_SERVER_PORT=6001
REALTIME_WEBSOCKET=false


# =============================================================================
# [12] TELEGRAM — cũng quản lý tại /settings sau settings:import-from-env
# =============================================================================
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_DAILY_REPORT_REVIEW=true
TELEGRAM_BLOCKER_RESOLVED=true
TELEGRAM_BLOCKER_CHAT_ID=


# =============================================================================
# [13] OCR Phiếu Đề Xuất (ocr-service FastAPI trên localhost server)
# =============================================================================
PROPOSAL_OCR_URL=http://127.0.0.1:8100
PROPOSAL_OCR_TOKEN=
PROPOSAL_OCR_TIMEOUT=30
