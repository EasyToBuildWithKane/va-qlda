##############################################################################
# VA QLDA — Production environment (mẫu)
# Domain: https://projects.vaschools.edu.vn
# Hệ Thống Quốc Tế Trường Việt Mỹ VA Schools
#
# Cấu hình vận hành (Telegram, domain Google, email công việc, nhắc AI…):
#   Quản trị → Cấu hình hệ thống → /settings (lưu DB, không cần deploy).
# Copy file này thành .env trên server và điền giá trị thật (APP_KEY, DB, OAuth, SMTP).
##############################################################################


# =============================================================================
# [1] APPLICATION CORE
# =============================================================================
APP_NAME="VA QLDA"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://projects.vaschools.edu.vn

# Tạm thời: false = entry login/dashboard; landing CN chỉ tại /demo_1;
# /congnghe và /phongcongnghe redirect. Bật true khi mở lại landing công khai.
CONGNGHE_LANDING_PUBLIC=false

VITE_APP_NAME="${APP_NAME}"


# =============================================================================
# [2] LOGGING
# =============================================================================
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning


# =============================================================================
# [3] DATABASE — MySQL
# =============================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=va_qlda_prod
DB_USERNAME=
DB_PASSWORD=

# Nguồn nhân sự SSOT — Public API v1 (M2M). Không đọc DB va_hrm từ QLDA.
# Nhân sự tự tạo (lazy upsert) khi Google/SSO login lần đầu — không cần lệnh sync.
# HRM Public API v1 — token mint tại /admin/api-clients (client qlda)
# JWT SSO ≠ Bearer này.
HRM_API_BASE_URL=https://hrm.vaschools.edu.com/api/v1
HRM_API_TOKEN=


# =============================================================================
# [4] CACHE / SESSION / QUEUE
# =============================================================================
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=.vaschools.edu.vn
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=sync
BROADCAST_DRIVER=log
FILESYSTEM_DISK=public


# =============================================================================
# [5] SANCTUM (Inertia SPA)
# =============================================================================
SANCTUM_STATEFUL_DOMAINS=projects.vaschools.edu.vn


# =============================================================================
# [6] GOOGLE OAUTH — chỉ client secret (domain/email → /settings → Đăng nhập)
# Callback: ${APP_URL}/auth/google/callback
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# =============================================================================
# [6b] SSO HRM → QLDA — HRM là IdP nội bộ (user Google login một lần trên HRM)
# Bật: HRM_SSO_ENABLED=true; callback ${APP_URL}/auth/hrm/callback phải nằm
# trong whitelist redirect_uris của client `qlda` trên HRM (/admin/api-clients,
# sso_enabled=true, khóa: php artisan hrm:sso-keys phía HRM).
# HRM_SSO_ISSUER khớp SSO_ISSUER phía HRM. Khi bật, nút login đi qua HRM —
# không gọi Google OAuth riêng trên QLDA nữa.
# =============================================================================
HRM_SSO_ENABLED=false
HRM_SSO_BASE_URL=https://hrm.vaschools.edu.vn
HRM_SSO_CLIENT_ID=qlda
HRM_SSO_AUDIENCE=qlda
# HRM_SSO_ISSUER=https://hrm.vaschools.edu.vn
# HRM_SSO_JWKS_URL="${HRM_SSO_BASE_URL}/.well-known/jwks.json"


# =============================================================================
# [7] MAIL — SMTP transport (bật/tắt gửi email công việc → /settings → Email)
# =============================================================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=


# =============================================================================
# [8] REDIS — (khi chuyển CACHE_DRIVER / SESSION_DRIVER / QUEUE sang redis)
# =============================================================================
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379


# =============================================================================
# [9] REALTIME — Socket.IO (npm run realtime + proxy /socket.io/)
# =============================================================================
REALTIME_ENABLED=true
REALTIME_SECRET="${APP_KEY}"
REALTIME_REDIS_CHANNEL=va-qlda:realtime
REALTIME_CLIENT_URL=https://projects.vaschools.edu.vn
REALTIME_SERVER_PORT=6001
REALTIME_WEBSOCKET=false


# =============================================================================
# [10] TELEGRAM — (cũng có thể quản lý tại /settings sau settings:import-from-env)
# =============================================================================
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_DAILY_REPORT_REVIEW=true
TELEGRAM_BLOCKER_RESOLVED=true
TELEGRAM_BLOCKER_CHAT_ID=


# =============================================================================
# [11] OCR Phiếu Đề Xuất (ocr-service FastAPI trên localhost server)
# =============================================================================
PROPOSAL_OCR_URL=http://127.0.0.1:8100
PROPOSAL_OCR_TOKEN=
PROPOSAL_OCR_TIMEOUT=30


# =============================================================================
# [12] AUTH — POST /login chỉ E2E/PHPUnit; production = false
# =============================================================================
AUTH_PASSWORD_LOGIN=false
