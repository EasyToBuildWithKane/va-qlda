##############################################################################
# VA QLDA — Production environment (mẫu)
# Domain: https://projects.vaschools.edu.vn
# Hệ Thống Quốc Tế Trường Việt Mỹ VA Schools
#
# Cấu hình vận hành (Telegram, domain Google, email công việc, nhắc AI…):
#   Quản trị → Cấu hình hệ thống → /settings (lưu DB, không cần deploy).
# Copy file này thành .env trên server và điền giá trị thật (APP_KEY, DB, OAuth, SMTP).
##############################################################################


# =============================================================================
# [1] APPLICATION CORE
# =============================================================================
APP_NAME="VA QLDA"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://projects.vaschools.edu.vn

# Tạm thời: false = entry login/dashboard; landing CN chỉ tại /demo_1;
# /congnghe và /phongcongnghe redirect. Bật true khi mở lại landing công khai.
CONGNGHE_LANDING_PUBLIC=false

VITE_APP_NAME="${APP_NAME}"


# =============================================================================
# [2] LOGGING
# =============================================================================
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning


# =============================================================================
# [3] DATABASE — MySQL
# =============================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=va_qlda_prod
DB_USERNAME=
DB_PASSWORD=

# CMS HR (read-only) — php artisan cms:sync-employees
CMS_DB_HOST=127.0.0.1
CMS_DB_PORT=3306
CMS_DB_DATABASE=
CMS_DB_USERNAME=
CMS_DB_PASSWORD=


# =============================================================================
# [4] CACHE / SESSION / QUEUE
# =============================================================================
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=.vaschools.edu.vn
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=sync
BROADCAST_DRIVER=log
FILESYSTEM_DISK=public


# =============================================================================
# [5] SANCTUM (Inertia SPA)
# =============================================================================
SANCTUM_STATEFUL_DOMAINS=projects.vaschools.edu.vn


# =============================================================================
# [6] GOOGLE OAUTH — chỉ client secret (domain/email → /settings → Đăng nhập)
# Callback: ${APP_URL}/auth/google/callback
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"


# =============================================================================
# [7] MAIL — SMTP transport (bật/tắt gửi email công việc → /settings → Email)
# =============================================================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=


# =============================================================================
# [8] REDIS — (khi chuyển CACHE_DRIVER / SESSION_DRIVER / QUEUE sang redis)
# =============================================================================
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379


# =============================================================================
# [9] REALTIME — Socket.IO (npm run realtime + proxy /socket.io/)
# =============================================================================
REALTIME_ENABLED=true
REALTIME_SECRET="${APP_KEY}"
REALTIME_REDIS_CHANNEL=va-qlda:realtime
REALTIME_CLIENT_URL=https://projects.vaschools.edu.vn
REALTIME_SERVER_PORT=6001
REALTIME_WEBSOCKET=false
