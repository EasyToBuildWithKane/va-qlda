APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Google OAuth (login UI). Callback must match Google Cloud console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# ── Sau khi deploy: quản lý tại /settings → Đăng nhập & Bảo mật ──────────────
# GOOGLE_ALLOWED_DOMAINS và GOOGLE_ALLOWED_EMAILS đã chuyển sang /settings (DB).
# Giá trị dưới đây chỉ dùng khi bảng system_settings còn trống (fresh deploy).
# Chạy: php artisan settings:import-from-env   để seed DB từ .env một lần.
GOOGLE_ALLOWED_DOMAINS=vaschools.edu.vn,hcm.vaschools.edu.vn
# Gợi ý domain trên UI Google (AccountChooser). Để trống nếu không cần.
# GOOGLE_HOSTED_DOMAIN=hcm.vaschools.edu.vn
# GOOGLE_ALLOWED_EMAILS=minhtu270404@gmail.com

# POST /login for PHPUnit & Playwright only (hidden from login page). false on production.
AUTH_PASSWORD_LOGIN=true

# ── SSO HRM → Workspace (thay Google lần hai) ─────────────────────────────────────
# HRM = IdP nội bộ. Bật SSO: HRM_SSO_ENABLED=true + base URL HRM; callback cố
# định {APP_URL}/auth/hrm/callback — whitelist tuyệt đối trên HRM
# (/admin/api-clients, client `workspace`, sso_enabled=true). JWKS mặc định
# {BASE}/.well-known/jwks.json; HRM_SSO_ISSUER phải khớp SSO_ISSUER phía HRM.
HRM_SSO_ENABLED=false
HRM_SSO_BASE_URL=https://hrm.vaschools.edu.vn
HRM_SSO_CLIENT_ID=workspace
HRM_SSO_AUDIENCE=workspace
# HRM_SSO_ISSUER=https://hrm.vaschools.edu.vn
# HRM_SSO_JWKS_URL=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# ── HRM Public API v1 (M2M Sanctum) — mint tại HRM /admin/api-clients (client workspace)
# Nguồn danh tính login/upsert duy nhất (không đọc DB va_hrm). JWT SSO ≠ Bearer này.
HRM_API_BASE_URL=https://hrm.vaschools.edu.com/api/v1
HRM_API_TOKEN=
# HRM_API_TIMEOUT=10
# Windows/ServBay: nếu cURL error 60 — để trống (app dùng openssl.cafile) hoặc:
# HRM_API_CA_BUNDLE=C:/ServBay/ssl/cacert.pem
# Chỉ local khi CA nội bộ: HRM_API_VERIFY_SSL=false

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"

# ── Email & Thông báo AI (/settings → Email & Thông báo) ──────────────────────
# Các key dưới đây đã chuyển sang /settings (DB). Giữ ở đây chỉ cho fresh deploy.
AI_ACCOUNT_REMINDER_EMAIL=true
# AI_ACCOUNT_REMINDER_EXTRA_EMAILS=

# ── Telegram (/settings → Thông báo Telegram) ─────────────────────────────────
# Tất cả TELEGRAM_* đã chuyển sang /settings (DB) — không cần trong .env sau khi
# chạy: php artisan settings:import-from-env
# Để trống hoặc bỏ comment để dùng khi fresh deploy / CI tests.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_DAILY_REPORT_REVIEW=true
# Vướng mắc đã giải quyết/đóng — lấy chat_id: php artisan telegram:list-chats
TELEGRAM_BLOCKER_RESOLVED=true
TELEGRAM_BLOCKER_CHAT_ID=

# ── LLM báo cáo tuần (/settings → Trí tuệ nhân tạo) ───────────────────────────
# Super Admin cấu hình tại /settings/ai (DB overlay). Giữ ở đây cho fresh deploy.
# WEEKLY_REPORT_LLM_ENABLED=false
# WEEKLY_REPORT_LLM_PROVIDER=nvidia
# WEEKLY_REPORT_LLM_API_KEY=
# WEEKLY_REPORT_LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# WEEKLY_REPORT_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# WEEKLY_REPORT_LLM_TIMEOUT=40

# ── OCR Phiếu Đề Xuất (ocr-service/ — Python FastAPI + Gemini) ────────────────
# Chạy local: xem ocr-service/README.md. Để trống = tắt nút «Quét phiếu (OCR)» xử lý.
PROPOSAL_OCR_URL=
PROPOSAL_OCR_TOKEN=
PROPOSAL_OCR_TIMEOUT=30

VITE_APP_NAME="${APP_NAME}"

# Realtime trao đổi (Socket.IO) — production: bật + npm run realtime (systemd) + proxy /socket.io/
REALTIME_ENABLED=true
REALTIME_SECRET="${APP_KEY}"
REALTIME_REDIS_CHANNEL=va-workspace:realtime
# Cùng domain app (Nginx/OpenLiteSpeed proxy → :6001). Local dev có thể http://127.0.0.1:6001
REALTIME_CLIENT_URL="${APP_URL}"
REALTIME_SERVER_PORT=6001
# false = chỉ long-polling (ổn khi LiteSpeed WS upgrade lỗi). true khi proxy WS đã test OK.
REALTIME_WEBSOCKET=false
