APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Google OAuth (login UI). Callback must match Google Cloud console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
GOOGLE_ALLOWED_DOMAINS=vaschools.edu.vn
# Email Google ngoại lệ (từng địa chỉ, không mở cả @gmail.com). Chỉ module Coaching.
# GOOGLE_ALLOWED_EMAILS=minhtu270404@gmail.com

# POST /login for PHPUnit & Playwright only (hidden from login page). false on production.
AUTH_PASSWORD_LOGIN=true

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# CMS HR (read-only). Lệnh: php artisan cms:sync-employees
CMS_DB_HOST=127.0.0.1
CMS_DB_PORT=3306
CMS_DB_DATABASE=
CMS_DB_USERNAME=
CMS_DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Nhắc tài khoản AI sắp hết hạn — inbox + mail tới admin/lead (email từ CMS sync: employees.email)
AI_ACCOUNT_REMINDER_EMAIL=true
# Tuỳ chọn: thêm email (phân tách dấu phẩy) nếu không nằm trong nhân sự CMS
AI_ACCOUNT_REMINDER_EXTRA_EMAILS=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Realtime trao đổi (Socket.IO) — production: bật + npm run realtime (systemd) + proxy /socket.io/
REALTIME_ENABLED=true
REALTIME_SECRET="${APP_KEY}"
REALTIME_REDIS_CHANNEL=va-qlda:realtime
# Cùng domain app (Nginx/OpenLiteSpeed proxy → :6001). Local dev có thể http://127.0.0.1:6001
REALTIME_CLIENT_URL="${APP_URL}"
REALTIME_SERVER_PORT=6001
# false = chỉ long-polling (ổn khi LiteSpeed WS upgrade lỗi). true khi proxy WS đã test OK.
REALTIME_WEBSOCKET=false

# Telegram — thông báo channel khi duyệt hoặc trả báo cáo ngày (/daily-reports/review)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_DAILY_REPORT_REVIEW=true
# Vướng mắc đã giải quyết/đóng (/blockers) — cùng bot, chat_id riêng; lấy ID: php artisan telegram:list-chats
TELEGRAM_BLOCKER_RESOLVED=true
TELEGRAM_BLOCKER_CHAT_ID=
